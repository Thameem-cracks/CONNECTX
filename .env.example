# =============================================
# ConnectX Environment Variables - EXAMPLE FILE
# Copy to .env and fill in real values.
# NEVER commit a .env file with real credentials.
# =============================================

# ---- FRONTEND (.env inside frontend/) ----
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ---- BACKEND ----
PORT=8080
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
# For JWKS-based JWT verification (recommended):
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# For symmetric JWT verification (only if Supabase project uses HS256 secret):
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret
MAX_CLIENTS=1000
MAX_MESSAGE_SIZE_BYTES=65536
LOG_LEVEL=info
